generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  WAREHOUSE_MANAGER
  DEALER
  BUYER
}

enum DealerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WarehouseType {
  MANUFACTURING
  WAREHOUSE
  DISTRIBUTION_CENTER
}

enum FinishType {
  MATTE
  GLOSSY
  SEMI_GLOSSY
  METALLIC
}

enum InventoryStatus {
  AVAILABLE
  DAMAGED
  EXPIRED
  QUARANTINE
}

enum OrderType {
  DEALER_ORDER
  CUSTOMER_ORDER
  TRANSFER_ORDER
  REFUND_REQUEST
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum TransactionType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
  DAMAGE
}

enum AlertType {
  LOW_STOCK
  OVERSTOCK
  EXPIRED
  ORDER_DELAYED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  ORDER_UPDATE
  SYSTEM_ALERT
  PROMOTION
  REMINDER
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

// -----------------------------------------------------------------------------
// Core Models
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            UserRole  @default(BUYER)
  isActive        Boolean   @default(true)
  isVerified      Boolean   @default(false)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relationships
  dealerProfile   Dealer?
  managedWarehouse Warehouse? 
  orders          Order[]
  notifications   Notification[]
  alerts          Alert[]
  transactions    InventoryTransaction[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordReset[]

  @@index([email])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
}

model PasswordReset {
  id          String   @id @default(uuid())
  userId      String
  code        String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

model EmailVerification {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Dealer {
  id                String             @id @default(uuid())
  userId            String             @unique
  businessName      String
  registrationNumber String?
  gstNumber         String?
  panNumber         String?
  
  // Contact
  email             String
  phone             String
  alternatePhone    String?
  
  // Address
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  pincode           String
  country           String             @default("India")
  
  // Geolocation
  latitude          Float?
  longitude         Float?
  
  // Business Logic
  creditLimit       Decimal            @default(0) @db.Decimal(10, 2)
  creditDays        Int                @default(0)
  discountPercentage Decimal           @default(0) @db.Decimal(5, 2)
  
  status            DealerStatus       @default(ACTIVE)
  verificationStatus VerificationStatus @default(PENDING)
  dealerTier        String             @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  
  parentDealerId    String?
  parentDealer      Dealer?            @relation("DealerHierarchy", fields: [parentDealerId], references: [id])
  subDealers        Dealer[]           @relation("DealerHierarchy")
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relationships
  user              User               @relation(fields: [userId], references: [id])
  orders            Order[]

  @@index([gstNumber])
}

model Warehouse {
  id                String          @id @default(uuid())
  name              String
  code              String          @unique
  type              WarehouseType   @default(WAREHOUSE)
  managerId         String?         @unique
  
  addressLine1      String?
  city              String?
  state             String?
  pincode           String?
  
  latitude          Float?
  longitude         Float?
  
  totalCapacity     Float           @default(0)
  currentUtilization Float          @default(0)
  isActive          Boolean         @default(true)
  operationalHours  Json?           // { "mon": "09:00-18:00", ... }

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relationships
  manager           User?           @relation(fields: [managerId], references: [id])
  inventory         Inventory[]
  orders            Order[]         @relation("FulfillingWarehouse")
  forecasts         DemandForecast[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  parentId    Int?
  displayOrder Int      @default(0)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relationships
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
}

model Product {
  id              String    @id @default(uuid())
  sku             String    @unique
  name            String
  description     String?
  categoryId      Int
  
  brand           String    @default("Modern Colours")
  colorCode       String?   // Hex code
  colorName       String?
  finishType      FinishType @default(MATTE)
  
  containerSize   Float
  containerType   String    // e.g. "Can", "Bucket"
  unitOfMeasure   String    // e.g. "L", "KG"
  
  basePrice       Decimal   @db.Decimal(10, 2)
  mrp             Decimal   @db.Decimal(10, 2)
  gstPercentage   Decimal   @default(18.0) @db.Decimal(5, 2)
  
  reorderLevel    Int       @default(10)
  reorderQuantity Int       @default(50)
  leadTimeDays    Int       @default(7)
  
  isFastMoving    Boolean   @default(false)
  isSeasonal      Boolean   @default(false)
  season          String?
  
  isActive        Boolean   @default(true)
  isDiscontinued  Boolean   @default(false)
  
  imageUrls       String[]
  documentUrls    String[]  // MSDS, Tech Sheets

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  category        Category  @relation(fields: [categoryId], references: [id])
  inventory       Inventory[]
  orderItems      OrderItem[]
  transactions    InventoryTransaction[]
  forecasts       DemandForecast[]

  @@index([name])
}

model Inventory {
  id                String           @id @default(uuid())
  productId         String
  warehouseId       String
  
  quantity          Int              @default(0)
  reservedQuantity  Int              @default(0)
  
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  
  rackNumber        String?
  binNumber         String?
  
  status            InventoryStatus  @default(AVAILABLE)
  lastUpdated       DateTime         @updatedAt

  // Relationships
  product           Product          @relation(fields: [productId], references: [id])
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId, batchNumber])
  @@index([expiryDate])
}

model Order {
  id                String       @id @default(uuid())
  orderNumber       String       @unique
  
  dealerId          String?
  customerId        String?
  warehouseId       String?      // Fulfilling warehouse
  
  orderType         OrderType    @default(DEALER_ORDER)
  orderStatus       OrderStatus  @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  
  // Amounts
  subtotal          Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal      @default(0) @db.Decimal(12, 2)
  shippingCharges   Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal      @default(0) @db.Decimal(12, 2)
  
  deliveryAddress   Json
  
  estimatedDeliveryDate DateTime?
  actualDeliveryDate    DateTime?
  
  paymentMethod     String?
  paymentTerms      String?
  
  trackingNumber    String?
  transporterName   String?
  
  notes             String?
  
  auditCreatedBy    String?
  auditApprovedBy   String?
  auditApprovedAt   DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relationships
  dealer            Dealer?      @relation(fields: [dealerId], references: [id])
  customer          User?        @relation(fields: [customerId], references: [id])
  warehouse         Warehouse?   @relation("FulfillingWarehouse", fields: [warehouseId], references: [id])
  items             OrderItem[]
  
  @@index([orderNumber])
  @@index([dealerId])
}

model OrderItem {
  id                String    @id @default(uuid())
  orderId           String
  productId         String
  
  quantity          Int
  fulfilledQuantity Int       @default(0)
  
  unitPrice         Decimal   @db.Decimal(10, 2)
  discountPercentage Decimal? @db.Decimal(5, 2)
  discountAmount    Decimal   @default(0) @db.Decimal(10, 2)
  taxPercentage     Decimal   @default(18.0) @db.Decimal(5, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(10, 2)
  lineTotal         Decimal   @db.Decimal(12, 2)

  // Relationships
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product   @relation(fields: [productId], references: [id])
}

model InventoryTransaction {
  id                String          @id @default(uuid())
  transactionTime   DateTime        @default(now())
  
  productId         String
  warehouseId       String?
  
  transactionType   TransactionType
  
  quantityBefore    Int
  quantityChange    Int
  quantityAfter     Int
  
  referenceType     String          // e.g. "ORDER", "GRN", "ADJUSTMENT"
  referenceId       String?         // ID of Order or related doc
  
  notes             String?
  performedById     String?

  // Relationships
  product           Product         @relation(fields: [productId], references: [id])
  user              User?           @relation(fields: [performedById], references: [id])

  @@index([transactionTime])
}

model DemandForecast {
  id                String    @id @default(uuid())
  productId         String
  warehouseId       String
  
  forecastDate      DateTime
  forecastHorizon   Int       // Days: 30, 60, 90
  
  predictedQuantity Float
  confidenceScore   Float     // 0.0 to 1.0
  
  lowerBound        Float?
  upperBound        Float?
  
  modelName         String?
  modelVersion      String?
  
  actualQuantity    Float?
  accuracyPercentage Float?
  
  generatedAt       DateTime  @default(now())

  // Relationships
  product           Product   @relation(fields: [productId], references: [id])
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
}

model Alert {
  id            String        @id @default(uuid())
  alertType     AlertType
  severity      AlertSeverity
  
  entityType    String        // "PRODUCT", "ORDER", "WAREHOUSE"
  entityId      String?
  
  title         String
  message       String
  
  assignedToId  String?
  
  status        AlertStatus   @default(ACTIVE)
  
  createdAt     DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt    DateTime?

  // Relationships
  assignedTo    User?         @relation(fields: [assignedToId], references: [id])
}

model Notification {
  id          String              @id @default(uuid())
  userId      String
  
  type        NotificationType
  channel     NotificationChannel
  
  title       String
  body        String
  
  status      String              @default("PENDING") // PENDING, SENT, READ
  
  sentAt      DateTime?
  readAt      DateTime?
  
  metadata    Json?
  
  createdAt   DateTime            @default(now())

  // Relationships
  user        User                @relation(fields: [userId], references: [id])
}
