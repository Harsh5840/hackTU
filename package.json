{
  "name": "modern-colours-supply-chain",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend/*",
    "backend/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend/api-gateway\" \"cd frontend && npm run dev\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "docker-compose up -d",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint ."
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
